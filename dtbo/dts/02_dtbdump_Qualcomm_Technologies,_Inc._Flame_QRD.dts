	fragment@100 {
		phandle = <0xa1>;
		target = <0xffffffff>;

		__overlay__ {

			display_panel_avdd_default {
				phandle = <0x6c>;

				mux {
					function = "gpio";
					pins = "gpio127";
				};

				config {
					output-high;
					bias-disable = <0x00>;
					drive-strength = <0x08>;
					pins = "gpio127";
				};
			};

			pmx_sde {
				phandle = <0x81>;

				sde_dsi_active {
					phandle = <0x65>;

					mux {
						function = "gpio";
						pins = "gpio92";
					};

					config {
						bias-disable = <0x00>;
						drive-strength = <0x08>;
						pins = "gpio92";
					};
				};

				sde_dsi_suspend {
					phandle = <0x67>;

					mux {
						function = "gpio";
						pins = "gpio92";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio92";
					};
				};
			};

			pmx_sde_te {
				phandle = <0x82>;

				sde_te_active {
					phandle = <0x66>;

					mux {
						function = "mdp_vsync_p";
						pins = "gpio93";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio93";
					};
				};

				sde_te_suspend {
					phandle = <0x68>;

					mux {
						function = "mdp_vsync_p";
						pins = "gpio93";
					};

					config {
						bias-pull-down;
						drive-strength = <0x02>;
						pins = "gpio93";
					};
				};
			};
		};
	};

